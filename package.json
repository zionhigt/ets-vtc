{
  "name": "ets-vtc",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme VTC pour Euro Truck Simulator 2 : serveur de télémétrie, tracker client, site public — les dépendances déclarées ici sont celles du serveur (installées par cPanel à la racine)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "start": "npm start -w @ets-vtc/server",
    "dev": "npm run dev -w @ets-vtc/server",
    "create-admin": "npm run create-admin -w @ets-vtc/server --",
    "replay": "node tools/replay-ndjson.js",
    "site-link": "npm run site-link -w @ets-vtc/server --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zionhigt/ets-vtc.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "zod": "^3.24.0"
  }
}

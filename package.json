{
  "name": "ets-vtc",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme VTC pour Euro Truck Simulator 2 : serveur de télémétrie, tracker client, site public",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "start": "npm start -w @ets-vtc/server",
    "dev": "npm run dev -w @ets-vtc/server",
    "create-admin": "npm run create-admin -w @ets-vtc/server --",
    "replay": "node tools/replay-ndjson.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zionhigt/ets-vtc.git"
  },
  "license": "UNLICENSED"
}

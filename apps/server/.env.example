# Copier en .env et adapter. Ne jamais versionner .env.
NODE_ENV=development
PORT=3000

# sqlite (dev, tests) ou mysql (production o2switch)
DB_CLIENT=sqlite
SQLITE_FILE=./data/vtc.sqlite

# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# Secret de signature des jetons (32 caractères minimum, obligatoire en production)
JWT_SECRET=change-me-change-me-change-me-change-me

# Durées de vie : jeton d'accès (secondes), jeton de rafraîchissement (jours)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Version minimale du tracker acceptée
MIN_TRACKER_VERSION=0.0.0

# Derrière le reverse proxy d'o2switch
TRUST_PROXY=1
